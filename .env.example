# ==============================================================================
# SW Service Desk v1.0 - Configuração de Ambiente
# SW Cloud Solutions
# ==============================================================================

# Servidor & Ambiente
NODE_ENV="development" # "production" ou "development"
PORT=3000
APP_URL="http://localhost:3000"

# IA Privada (Gemini API)
# Injetado automaticamente pelo Google AI Studio no ambiente cloud
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Base de Dados Relacional (MySQL / MariaDB como Fonte de Verdade)
# Em ambiente sem daemon externo, o sistema recorre ao motor SQL SQLite com
# persistência relacional idêntica sem uso de JSON/localStorage.
DB_DIALECT="mysql" # "mysql" ou "sqlite"
DB_HOST="localhost"
DB_PORT=3306
DB_USER="sw_desk_user"
DB_PASSWORD="sw_secure_password"
DB_NAME="sw_servicedesk"
DB_CONNECTION_LIMIT=20
DB_SQLITE_PATH="./data/sw_servicedesk.sqlite"

# Segurança & Sessões
JWT_SECRET="sw_super_secret_jwt_key_replace_in_production_min_32_chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7
SESSION_COOKIE_NAME="sw_sd_session"
CSRF_SECRET="sw_csrf_secret_random_token_key"

# Uploads & Anexos
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,application/pdf,application/zip,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"

# Integrações Microsoft 365 & Email (SMTP / Graph API)
M365_ENABLED=false
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="servicedesk@swcloudsolutions.com"
SMTP_PASS=""
EMAIL_FROM_NAME="SW Cloud Service Desk"
EMAIL_FROM_ADDRESS="servicedesk@swcloudsolutions.com"

# Integração Microsoft Teams (Webhooks de Notificação de Incidentes Críticos)
TEAMS_WEBHOOK_URL=""

# Auditoria e Logs
LOG_LEVEL="info"
